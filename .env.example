# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# --- Exchange Selection ---
# Supported values: "alpaca" | "binance"
EXCHANGE=alpaca

# --- Alpaca Paper Trading ---
# Get keys at https://app.alpaca.markets (switch to Paper mode)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Leave as-is for paper trading; change to live URL for real trading
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Binance Testnet (used when EXCHANGE=binance) ---
# Get keys at https://testnet.binance.vision/
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# --- Trading Parameters ---
TRADING_PAIR=BTC/USD
# Timeframe for OHLCV candles: 1m, 5m, 15m, 1h, 4h, 1d
TIMEFRAME=1h
# Number of historical candles to fetch (must be >= 200 for SMA-200)
CANDLE_LIMIT=250
# Order size in base currency (e.g. 0.001 BTC)
ORDER_SIZE=0.001
